    {
      "parameters": {
        "content": "## Flujo 02 · Confirmación de asistencia\nEl botón del correo llama a este webhook con el **token** del lead.\nEtapa **Contactado → Confirmado** y respuesta HTML al usuario.",
        "width": 420,
        "height": 180,
        "color": 7
      },
      "id": "f2-note-01",
      "name": "Nota 01",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -240
      ]
    },
    {
      "parameters": {
        "path": "confirmar",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "f2-webhook",
      "name": "Clic en «Confirmo asistencia»",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "9d8c7b6a-5f4e-4d3c-8b2a-1f0e9d8c7b6a"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Contactado/Nuevo → Confirmado, buscando por token (comparado como texto\n-- para que un token mal formado no rompa la consulta) + historial.\nWITH prev AS (\n  SELECT id, nombre, etapa FROM leads WHERE token::text = $1\n), upd AS (\n  UPDATE leads l\n     SET etapa = 'Confirmado', fecha_confirmacion = now(), updated_at = now()\n    FROM prev\n   WHERE l.id = prev.id AND prev.etapa IN ('Nuevo', 'Contactado')\n  RETURNING l.id, prev.etapa AS etapa_anterior\n), hist AS (\n  INSERT INTO historial_etapas (lead_id, etapa_anterior, etapa_nueva, origen)\n  SELECT id, etapa_anterior, 'Confirmado', 'flujo_02:clic_confirmacion' FROM upd\n)\nSELECT (SELECT count(*) FROM upd)::int AS actualizado,\n       (SELECT nombre FROM prev)       AS nombre,\n       (SELECT etapa  FROM prev)       AS etapa_previa;",
        "options": {
          "queryReplacement": "={{ [ $json.query.token ?? '' ] }}"
        }
      },
      "id": "f2-pg-confirmar",
      "name": "Actualizar etapa: Confirmado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "renaserPgCrm0001",
          "name": "Postgres CRM (local)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f2-if-ok-c1",
              "leftValue": "={{ $json.actualizado }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f2-if-ok",
      "name": "¿Se confirmó?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!doctype html><html lang=\"es\"><head><meta charset=\"utf-8\"><title>¡Asistencia confirmada! 🎉</title><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"font-family:Arial,sans-serif;background:#f5f3ff;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0\"><div style=\"background:#fff;padding:40px;border-radius:14px;max-width:440px;text-align:center;box-shadow:0 10px 30px rgba(0,0,0,.08)\"><h1 style=\"color:#6d28d9\">¡Asistencia confirmada! 🎉</h1><p style=\"color:#374151\">Gracias {{ $json.nombre }}, tu lugar está asegurado. Te enviaremos un recordatorio antes del evento.</p></div></body></html>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "f2-respond-ok",
      "name": "Página: confirmado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        660,
