    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!doctype html><html lang=\"es\"><head><meta charset=\"utf-8\"><title>{{ $json.etapa_previa ? 'Ya estabas confirmado' : 'Enlace no válido' }}</title><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"font-family:Arial,sans-serif;background:#f5f3ff;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0\"><div style=\"background:#fff;padding:40px;border-radius:14px;max-width:440px;text-align:center;box-shadow:0 10px 30px rgba(0,0,0,.08)\"><h1 style=\"color:#b45309\">{{ $json.etapa_previa ? 'Ya estabas confirmado' : 'Enlace no válido' }}</h1><p style=\"color:#374151\">{{ $json.etapa_previa ? 'Tu asistencia ya estaba registrada (etapa: ' + $json.etapa_previa + ').' : 'No encontramos este registro. Vuelve a inscribirte desde el formulario.' }}</p></div></body></html>",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
